<mxfile host="app.diagrams.net">
  <diagram id="report-flowchart" name="report flowchart">
    <mxGraphModel dx="1500" dy="1650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        
        <mxCell id="start" value="Start: svshare report" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="530" y="20" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="Is the database&lt;br&gt;a file?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="510" y="110" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="stop1" value="Stop: it isn't a file" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="900" y="135" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="Combine the --genes and&lt;br&gt;--gene-file genes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="510" y="250" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="Choose the output path&lt;br&gt;(default: next to the database)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="510" y="350.0" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="Print the report settings" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="510" y="450.0" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="Build the SV filter" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="510" y="550.0" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="Find the IDs of the SVs&lt;br&gt;that pass the filter" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="510" y="650.0" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="Print how many SVs pass" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="510" y="750.0" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="Is the format&lt;br&gt;TSV?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="510" y="1150" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="Print that HTML reports&lt;br&gt;aren't written yet" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="890" y="1170" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="Load those SVs,&lt;br&gt;in genome order" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="510" y="850" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="Write the TSV" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="510" y="1290.0" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="Print where the TSV was written" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="510" y="1390.0" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="end" value="End" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="530" y="1490.0" width="220" height="50" as="geometry" />
        </mxCell>

        
        <mxCell id="c1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="start" target="d1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d1" target="a1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d1" target="stop1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="a1" target="a2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="a2" target="m1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c11" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="m1" target="a3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c12" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="a3" target="a4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c13" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="a4" target="m2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c14" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="m2" target="a5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d4" target="a6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="No (HTML)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d4" target="m3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c18" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="a6" target="m4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c19" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="m4" target="end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c20" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m3" target="end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      <mxCell id="d5" value="Any genes with&lt;br&gt;no passing SVs?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="510" y="950" width="260" height="100" as="geometry" /></mxCell><mxCell id="m5" value="List the genes&lt;br&gt;with no passing SVs" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="890" y="970" width="260" height="60" as="geometry" /></mxCell><mxCell id="c21" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d5" target="m5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c22" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d5" target="d4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m5" target="d4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1020" y="1110" /><mxPoint x="640" y="1110" /></Array></mxGeometry></mxCell><mxCell id="c24" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="a5" target="d5"><mxGeometry relative="1" as="geometry" /></mxCell></root>
